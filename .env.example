# ==============================================================================
# JANSETU AI — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# "From Citizen Voice to Smarter Infrastructure"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16 + PostGIS 3.4 Spatial Engine)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jansetu_ai?schema=public"
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# ------------------------------------------------------------------------------
# 3. REDIS DISTRIBUTED CACHE & PUB/SUB MESSAGE BROKER
# ------------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
CACHE_DEFAULT_TTL=300

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET="jansetu-super-secret-jwt-key-production-civic-tech"
JWT_REFRESH_SECRET="jansetu-super-secret-refresh-key-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (Multimodal Vision, Audio STT, Multilingual Pipeline)
# ------------------------------------------------------------------------------
# Required for live Gemini multimodal analysis. In AI Studio, provided automatically.
GEMINI_API_KEY=""

# AI Demo Mode: If true or if GEMINI_API_KEY is unset, runs high-accuracy deterministic multilingual model
AI_DEMO_MODE=false

# Worker Concurrency & Circuit Breaker Thresholds
AI_WORKER_CONCURRENCY=10
AI_TIMEOUT_MS=12000
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (Citizen Media: Photos, Audio Recordings, Documents)
# Compatible with AWS S3, MinIO, Cloudflare R2, Google Cloud Storage S3 API
# ------------------------------------------------------------------------------
STORAGE_BUCKET="jansetu-media-assets"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="ap-south-1"
STORAGE_USE_SSL=false

# ------------------------------------------------------------------------------
# 7. RATE LIMITING (Requests Per Minute)
# ------------------------------------------------------------------------------
RATE_LIMIT_ANON=100
RATE_LIMIT_AUTH=600
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_AI=20
RATE_LIMIT_ADMIN=300

# ------------------------------------------------------------------------------
# 8. FEATURE FLAGS
# ------------------------------------------------------------------------------
ENABLE_REALTIME=true
ENABLE_AI_COPILOT=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_ASYNC_AI=true
IS_DEDICATED_WORKER=false
